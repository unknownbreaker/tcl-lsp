flagged	agree	expr {$x || $x || [f]}	expr {$x || [f]}
flagged	agree	if {$x == 1} {set r a} elseif {$x == 1} {set r b}	if {$x == 1} {set r a}
flagged	agree	if {$x} {set r a} elseif {$y} {set r b} elseif {$x} {set r c}	if {$x} {set r a} elseif {$y} {set r b}
