flagged	agree	if {$x} {set r a} {set r a}	if {$x} {}; set r a
flagged	agree	if {$x} {set r a} elseif {$y} {set r a} else {set r a}	if {$x} {} elseif {$y} {}; set r a
flagged	agree	if {[f]} {set r a} else {set r a}	if {[f]} {}; set r a
exempt	differ	expr {$x || [set x 1; expr 0] || $x}	expr {$x || [set x 1; expr 0]}
exempt	differ	expr {$x || g() || $x}	expr {$x || g()}
